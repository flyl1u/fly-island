diff --git a/dist/lib/lane-owner.js b/dist/lib/lane-owner.js
new file mode 100644
index 0000000000000000000000000000000000000000..8db3e15f158aebe9fef1c5e05293cacd439e66c8
--- /dev/null
+++ b/dist/lib/lane-owner.js
@@ -0,0 +1,81 @@
+// fly-island patch: Windows has no lsof, so the stock "is a session still in
+// this lane?" check always said yes and no lane was ever pruned. Instead the
+// WorktreeCreate hook records the claude.exe that asked for the lane, and a
+// lane counts as in use while that process is alive.
+import { execFileSync } from "node:child_process";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { repoKey } from "./queue-lock.js";
+
+function ownersFile() {
+    return join(repoKey(), "claude-code-merge-queue", "lane-owners.json");
+}
+function key(path) {
+    return resolve(path).toLowerCase();
+}
+function readOwners() {
+    try {
+        return JSON.parse(readFileSync(ownersFile(), "utf8"));
+    }
+    catch {
+        return {};
+    }
+}
+function writeOwners(owners) {
+    const file = ownersFile();
+    mkdirSync(dirname(file), { recursive: true });
+    writeFileSync(file, JSON.stringify(owners, null, 2) + "\n");
+}
+/** The nearest claude.exe above this process, or null. */
+export function findClaudeAncestorPid() {
+    if (process.platform !== "win32")
+        return null;
+    let rows;
+    try {
+        const out = execFileSync("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command",
+            "Get-CimInstance Win32_Process | Select-Object ProcessId,ParentProcessId,Name | ConvertTo-Json -Compress"], { encoding: "utf8", maxBuffer: 64 * 1024 * 1024, stdio: ["ignore", "pipe", "ignore"] });
+        rows = JSON.parse(out);
+    }
+    catch {
+        return null;
+    }
+    const byPid = new Map(rows.map((row) => [row.ProcessId, row]));
+    let row = byPid.get(process.pid);
+    for (let hops = 0; row && hops < 32; hops += 1) {
+        if (/^claude(\.exe)?$/i.test(row.Name ?? ""))
+            return row.ProcessId;
+        row = byPid.get(row.ParentProcessId);
+    }
+    return null;
+}
+export function recordLaneOwner(wt, pid) {
+    if (!pid)
+        return;
+    const owners = readOwners();
+    owners[key(wt)] = { pid, since: new Date().toISOString() };
+    writeOwners(owners);
+}
+export function forgetLaneOwner(wt) {
+    const owners = readOwners();
+    if (owners[key(wt)]) {
+        delete owners[key(wt)];
+        writeOwners(owners);
+    }
+}
+function alive(pid) {
+    try {
+        process.kill(pid, 0);
+        return true;
+    }
+    catch (e) {
+        return e.code === "EPERM";
+    }
+}
+/** true while the recorded owner runs; a lane with no record is treated as in use. */
+export function laneOwnerAlive(wt) {
+    const owner = readOwners()[key(wt)];
+    return owner ? alive(owner.pid) : true;
+}
+export function hasLaneOwner(wt) {
+    return Boolean(readOwners()[key(wt)]);
+}
