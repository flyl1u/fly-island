{
  "id": "dev.focusd.github-issues",
  "name": { "zh-CN": "GitHub Issue（示例）", "en": "GitHub issues (example)" },
  "description": {
    "zh-CN": "在岛上加一个页面，列出一个公开仓库的未关闭 issue，点一条就在浏览器里打开。不需要令牌，仓库在设置里填。演示列表模板。用 Windows 自带的 PowerShell 运行。",
    "en": "Adds an island page listing the open issues of a public repository; click one to open it in the browser. No token needed; set the repository in the settings. Shows the list template. Runs on the PowerShell built into Windows."
  },
  "version": "1.0.0",
  "apiVersion": 2,
  "author": "FocuSD",
  "homepage": "https://github.com/TixXin/fly-island/tree/dev/plugins/examples/dev.focusd.github-issues",
  "runtime": { "type": "process", "command": "main.ps1" },
  "permissions": [],
  "contributes": {
    "commands": [{ "id": "refresh", "title": { "zh-CN": "立即刷新", "en": "Refresh now" } }],
    "views": [{ "id": "issues", "title": { "zh-CN": "Issue", "en": "Issues" }, "icon": "git-pull-request", "template": "list" }],
    "settings": [
      { "key": "repo", "type": "string", "title": { "zh-CN": "仓库", "en": "Repository" }, "description": { "zh-CN": "owner/name，例如 TixXin/fly-island", "en": "owner/name, e.g. TixXin/fly-island" }, "default": "TixXin/fly-island" },
      { "key": "minutes", "type": "number", "title": { "zh-CN": "刷新间隔（分钟）", "en": "Refresh every (minutes)" }, "min": 5, "max": 120, "default": 15 }
    ]
  }
}
