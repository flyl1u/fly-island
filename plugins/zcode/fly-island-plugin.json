{
  "id": "zcode",
  "name": { "zh-CN": "智谱 ZCode", "en": "Zhipu ZCode" },
  "description": { "zh-CN": "智谱 ZCode 编码额度与体验额度", "en": "Zhipu ZCode coding quota and trial balances" },
  "version": "0.1.0",
  "apiVersion": 1,
  "runtime": { "command": "zcode.exe" },
  "permissions": ["quota", "network", "read-home-files"],
  "contributes": ["quota"],
  "settings": [
    {
      "key": "api_key",
      "label": { "zh-CN": "API Key（可选覆盖）", "en": "API Key (optional override)" },
      "type": "secret",
      "default": ""
    },
    {
      "key": "interval",
      "label": { "zh-CN": "刷新间隔", "en": "Refresh interval" },
      "type": "select",
      "default": "60",
      "options": [
        { "value": "60", "label": { "zh-CN": "1 分钟", "en": "1 minute" } },
        { "value": "180", "label": { "zh-CN": "3 分钟", "en": "3 minutes" } },
        { "value": "300", "label": { "zh-CN": "5 分钟", "en": "5 minutes" } }
      ]
    }
  ],
  "actions": []
}