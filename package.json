{
  "name": "focusd-island",
  "private": true,
  "version": "3.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:web-demo": "vite build --config vite.web-demo.config.ts",
    "release": "node scripts/release/release.mjs",
    "tauri": "tauri",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check:size": "node scripts/check-file-size.mjs",
    "test:regression": "node scripts/run-regression.mjs",
    "check:tests-types": "tsc -p tsconfig.tests.json",
    "lint": "eslint src",
    "check": "tsc && pnpm run check:tests-types && pnpm run lint && pnpm run check:size && pnpm run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7"
  }
}
