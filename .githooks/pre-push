#!/usr/bin/env sh
# claude-code-merge-queue: main only moves through `pnpm mq:land`, and
# scripts/land-check.mjs gates every push. Enabled with
# `git config core.hooksPath .githooks` (see AGENTS.md).
cli=node_modules/claude-code-merge-queue/dist/bin/claude-code-merge-queue.js
if [ ! -f "$cli" ]; then
  echo "pre-push: $cli is missing; run pnpm install in this worktree first." >&2
  exit 1
fi
exec node "$cli" check-push
